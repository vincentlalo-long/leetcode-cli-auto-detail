{
  "manifest_version": 3,
  "name": "LeetCode CLI Exporter",
  "version": "0.1.0",
  "description": "Save LeetCode problems to GitHub using the leetcode-cli layout.",
  "action": {
    "default_title": "Save LeetCode",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*"
  ]
}
